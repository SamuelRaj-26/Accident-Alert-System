# Accident Alert System API
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional Twilio SMS delivery. Leave blank for safe console/mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional SMTP email delivery. Leave blank for safe console/mock mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
# Device API key: set a long random value before connecting real hardware.
DEVICE_API_KEY=development-device-key
ACCIDENT_ALERT_SYSTEM_COLLISION_THRESHOLD=7.5
