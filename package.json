{
  "name": "accident-alert-system",
  "version": "1.0.0",
  "private": true,
  "description": "IoT vehicle collision monitoring and emergency notification platform",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --prefix backend run build",
    "build:client": "npm --prefix frontend run build"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
